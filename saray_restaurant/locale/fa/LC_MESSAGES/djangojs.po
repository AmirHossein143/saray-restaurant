# Persian overrides for Django's admin/auth/forms strings.
# Fills msgids missing or empty in Django's own fa catalog and replaces a few
# awkward ones. Loaded via LOCALE_PATHS, which takes precedence over Django.
# Regenerate the .mo after editing: python manage.py compilemessages
# (or, without GNU gettext: python locale/compile_mo.py).
msgid ""
msgstr ""
"Project-Id-Version: saray-restaurant\n"
"Language: fa\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

