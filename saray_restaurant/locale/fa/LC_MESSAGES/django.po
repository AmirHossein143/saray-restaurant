# Persian overrides for Django's admin/auth/forms strings.
# Fills msgids missing or empty in Django's own fa catalog and replaces a few
# awkward ones. Loaded via LOCALE_PATHS, which takes precedence over Django.
# Regenerate the .mo after editing: python manage.py compilemessages
# (or, without GNU gettext: python locale/compile_mo.py).
msgid ""
msgstr ""
"Project-Id-Version: saray-restaurant\n"
"Language: fa\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Run"
msgstr "اجرا"

#, python-format
msgid "Filter by %(field_name)s"
msgstr "فیلتر بر اساس %(field_name)s"

msgid "Please correct the error below."
msgid_plural "Please correct the errors below."
msgstr[0] "لطفاً خطای زیر را برطرف کنید."
msgstr[1] "لطفاً خطاهای زیر را برطرف کنید."

msgid "Select this object for an action - {}"
msgstr "انتخاب این مورد برای اقدام گروهی: {}"

msgid "Breadcrumbs"
msgstr "مسیر صفحه"

msgid "Model name"
msgstr "نام بخش"

#, python-format
msgid "Pagination %(name)s entries"
msgstr "صفحه‌بندی سوابق %(name)s"

#, python-format
msgid "Pagination %(name)s"
msgstr "صفحه‌بندی %(name)s"

#, python-format
msgid "Search %(name)s"
msgstr "جستجو در %(name)s"

msgid "Logout"
msgstr "خروج"

msgid "In case you’ve forgotten, you are:"
msgstr "اگر فراموش کرده‌اید، شما این کاربر هستید:"

msgid "entry"
msgid_plural "entries"
msgstr[0] "مورد"
msgstr[1] "مورد"

msgid ", "
msgstr "، "

#, python-format
msgid "…and %(count)d more object."
msgid_plural "…and %(count)d more objects."
msgstr[0] "…و %(count)d مورد دیگر."
msgstr[1] "…و %(count)d مورد دیگر."

#, python-format
msgid "The app \"%s\" could not be found."
msgstr "بخش «%s» پیدا نشد."

msgid "This action will <strong>enable</strong> password-based authentication for this user."
msgstr "با این کار، ورود با گذرواژه برای این کاربر <strong>فعال</strong> می‌شود."

#, python-format
msgid "Deleting the %(object_name)s “%(escaped_object)s” would result in deleting related objects, but your account doesn't have permission to delete the following types of objects:"
msgstr "حذف %(object_name)s «%(escaped_object)s» باعث حذف موارد مرتبط هم می‌شود، اما شما اجازهٔ حذف این نوع موارد را ندارید:"

#, python-format
msgid "Deleting the %(object_name)s “%(escaped_object)s” would require deleting the following protected related objects:"
msgstr "برای حذف %(object_name)s «%(escaped_object)s» باید این موارد محافظت‌شدهٔ مرتبط هم حذف شوند:"

#, python-format
msgid "Are you sure you want to delete the %(object_name)s “%(escaped_object)s”? All of the following related items will be deleted:"
msgstr "آیا از حذف %(object_name)s «%(escaped_object)s» مطمئن هستید؟ همهٔ موارد مرتبط زیر هم حذف خواهند شد:"

msgid "Delete selected %(verbose_name_plural)s"
msgstr "حذف موارد انتخاب‌شده"

msgid "Successfully deleted %(count)d %(items)s."
msgstr "%(count)d مورد با موفقیت حذف شد."

msgid "%(count)s %(name)s was changed successfully."
msgid_plural "%(count)s %(name)s were changed successfully."
msgstr[0] "%(count)s مورد با موفقیت ذخیره شد."
msgstr[1] "%(count)s مورد با موفقیت ذخیره شد."

#, python-format
msgid "0 of %(cnt)s selected"
msgstr "۰ از %(cnt)s انتخاب شده"

#, python-format
msgid "%(total_count)s selected"
msgid_plural "All %(total_count)s selected"
msgstr[0] "%(total_count)s مورد انتخاب شد"
msgstr[1] "همهٔ %(total_count)s مورد انتخاب شدند"

msgid "Select all %(total_count)s %(module_name)s"
msgstr "انتخاب همهٔ %(total_count)s مورد"

#, python-format
msgid "%(full_result_count)s total"
msgstr "از %(full_result_count)s مورد"

msgid "- Select an option -"
msgstr "— انتخاب کنید —"

msgid "Central Kurdish (Sorani)"
msgstr "کردی سورانی"

msgid "Uyghur"
msgstr "اویغوری"

msgid "Haitian Creole"
msgstr "کریول هائیتی"

msgid "Enter a valid domain name."
msgstr "یک نام دامنهٔ معتبر وارد کنید."

#, python-format
msgid "Enter a valid %(protocol)s address."
msgstr "یک نشانی %(protocol)s معتبر وارد کنید."

msgid "IPv4"
msgstr "IPv4"

msgid "IPv6"
msgstr "IPv6"

msgid "IPv4 or IPv6"
msgstr "IPv4 یا IPv6"

#, python-format
msgid "Ensure this value is a multiple of step size %(limit_value)s."
msgstr "این مقدار باید مضربی از %(limit_value)s باشد."

#, python-format
msgid "Ensure this value is a multiple of step size %(limit_value)s, starting from %(offset)s, e.g. %(offset)s, %(valid_value1)s, %(valid_value2)s, and so on."
msgstr "این مقدار باید از %(offset)s شروع شود و گام‌های %(limit_value)s داشته باشد؛ مثلاً %(offset)s، %(valid_value1)s، %(valid_value2)s و غیره."

#, python-format
msgid "Constraint “%(name)s” is violated."
msgstr "محدودیت «%(name)s» رعایت نشده است."

#, python-format
msgid "“%(value)s” is not a valid binary value."
msgstr "«%(value)s» یک مقدار دودویی معتبر نیست."

#, python-format
msgid "%(model)s instance with %(field)s %(value)r is not a valid choice."
msgstr "موردی از %(model)s با %(field)s برابر %(value)r انتخاب معتبری نیست."

#, python-format
msgid "Please submit at most %(num)d form."
msgid_plural "Please submit at most %(num)d forms."
msgstr[0] "لطفاً حداکثر %(num)d فرم ارسال کنید."
msgstr[1] "لطفاً حداکثر %(num)d فرم ارسال کنید."

#, python-format
msgid "Please submit at least %(num)d form."
msgid_plural "Please submit at least %(num)d forms."
msgstr[0] "لطفاً دست‌کم %(num)d فرم ارسال کنید."
msgstr[1] "لطفاً دست‌کم %(num)d فرم ارسال کنید."

#, python-format
msgid "No %s matches the given query."
msgstr "هیچ %s مطابق با این درخواست پیدا نشد."

msgid "Conflicting form data submitted. Please try again."
msgstr "اطلاعات فرم با هم تناقض داشت. لطفاً دوباره تلاش کنید."

msgid "Password-based authentication was disabled."
msgstr "ورود با گذرواژه غیرفعال شد."

#, python-format
msgid "Set password: %s"
msgstr "تعیین گذرواژه: %s"

msgid "Reset password"
msgstr "بازنشانی گذرواژه"

msgid "Set password"
msgstr "تعیین گذرواژه"

msgid "Whether the user will be able to authenticate using a password or not. If disabled, they may still be able to authenticate using other backends, such as Single Sign-On or LDAP."
msgstr "آیا کاربر می‌تواند با گذرواژه وارد شود یا نه. اگر غیرفعال باشد، ممکن است همچنان از راه‌های دیگر (مانند ورود یکپارچه یا LDAP) بتواند وارد شود."

msgid "Password-based authentication"
msgstr "ورود با گذرواژه"

msgid "Enabled"
msgstr "فعال"

msgid "Disabled"
msgstr "غیرفعال"

msgid "Raw passwords are not stored, so there is no way to see the user’s password."
msgstr "گذرواژه‌ها به‌صورت خام ذخیره نمی‌شوند، بنابراین راهی برای دیدن گذرواژهٔ کاربر وجود ندارد."

msgid "Enable password-based authentication for this user by setting a password."
msgstr "با تعیین گذرواژه، ورود با گذرواژه را برای این کاربر فعال کنید."

#, python-format
msgid "This password is too short. It must contain at least %d character."
msgid_plural "This password is too short. It must contain at least %d characters."
msgstr[0] "این گذرواژه خیلی کوتاه است و باید دست‌کم %d حرف داشته باشد."
msgstr[1] "این گذرواژه خیلی کوتاه است و باید دست‌کم %d حرف داشته باشد."

msgid "Enter a valid username. This value may contain only unaccented lowercase a-z and uppercase A-Z letters, numbers, and @/./+/-/_ characters."
msgstr "یک نام کاربری معتبر وارد کنید؛ فقط حروف انگلیسی (a-z و A-Z)، عدد و نویسه‌های @ . + - _ مجاز است."
